# Shlloka Yatra Environment Configuration

# Application
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection
# For local development with SQLite (no external DB installation needed):
DATABASE_URL="file:../prisma/dev.db"

# For Production with PostgreSQL (e.g. AWS RDS, Neon, Supabase, Railway):
# DATABASE_URL="postgresql://username:password@localhost:5432/shlloka_yatra?schema=public"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@shlloka.com
ADMIN_DEFAULT_PASSWORD=ShllokaAdmin@2027

# Payment Gateway (Sandbox Mode by Default)
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Transactional Email Service (Configurable SMTP)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_username
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM="Shlloka Yatra <volunteers@shlloka.com>"
